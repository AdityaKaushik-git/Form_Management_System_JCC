# Server
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database - MariaDB
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=jcc_reappear_exam
DATABASE_USER=root
DATABASE_PASSWORD=your_password

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_long_replace_this
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_long_replace_this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie
COOKIE_SECRET=your_cookie_secret_min_32_chars_long_replace_this

# Redis
REDIS_URL=redis://localhost:6379

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_PROJECT_ID=your-project-id

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="JCC Examinations <noreply@jcc.edu.in>"

# Admin Setup
ADMIN_SETUP_SECRET=change_this_to_a_strong_random_secret
