{
  "name": "jcc-reappear-backend",
  "version": "1.0.0",
  "description": "JCC Reappear Examination System - Backend API",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "worker": "node src/workers/index.js",
    "worker:dev": "node --watch src/workers/index.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo:all": "npx sequelize-cli db:seed:undo:all",
    "admin:create": "node src/scripts/createAdmin.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "sequelize": "^6.37.5",
    "mariadb": "^3.4.0",
    "socket.io": "^4.8.1",
    "jsonwebtoken": "^9.0.2",
    "argon2": "^0.41.1",
    "zod": "^3.23.8",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "bullmq": "^5.25.6",
    "ioredis": "^5.4.1",
    "googleapis": "^144.0.0",
    "pdfkit": "^0.15.1",
    "exceljs": "^4.4.0",
    "dayjs": "^1.11.13",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "nodemailer": "^6.9.16",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "multer": "^1.4.5-lts.1",
    "hpp": "^0.2.3"
  },
  "devDependencies": {}
}
